// launcher icon + version info
IDI_APPICON ICON "../assets/app.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404b0"
    BEGIN
      VALUE "CompanyName", "local"
      VALUE "FileDescription", "DeepSeek Local Launcher"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "DeepSeekLauncher"
      VALUE "OriginalFilename", "DeepSeekLauncher.exe"
      VALUE "ProductName", "DeepSeek Local"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x804, 1200
  END
END